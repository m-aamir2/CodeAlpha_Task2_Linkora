DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_RUNSERVER_ADDRESS=127.0.0.1:8001
FRONTEND_URL=http://localhost:5180
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Production requires a persistent PostgreSQL database. SQLite is for local development only.
DATABASE_URL=
# Redis channel-layer URL for multi-process/serverless WebSocket notification delivery.
# Local development uses an in-memory channel layer when this is blank.
REDIS_URL=
# Vercel Blob adds BLOB_READ_WRITE_TOKEN when a public Blob store is connected to the project.
# Only set USE_VERCEL_BLOB=true locally when you have configured a Blob store.
USE_VERCEL_BLOB=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
# Required in Vercel to authorize the scheduled expired-story cleanup route.
CRON_SECRET=
