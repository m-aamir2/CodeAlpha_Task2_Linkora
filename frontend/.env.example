VITE_API_URL=http://127.0.0.1:8001/api
# Production uses the same-origin /api/blob-upload route configured in vercel.json.
# Set this only if you move that authenticated upload function to another URL.
# VITE_BLOB_UPLOAD_URL=
# Optional JSON array of RTCIceServer objects. Calls use a public STUN server by default;
# configure your own TURN service in production for users behind restrictive NATs.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# Optional override. Local development defaults to the Django ASGI server on port 8001;
# production defaults to the same-origin /ws/notifications/ route.
# VITE_NOTIFICATIONS_WS_URL=ws://127.0.0.1:8001/ws/notifications/
